# cp .env.example .env — nichts hiervon ist ein Geheimnis, bis du eins einträgst.

# --- Die App -----------------------------------------------------------------

# Auf welchem Port die App erreichbar ist.
APP_PORT=3000

# 127.0.0.1 = nur dieser Rechner. 0.0.0.0 = das ganze Heimnetz, also auch das
# Telefon auf dem Sofa. Bewusste Entscheidung, deshalb steht sie hier.
APP_BIND=127.0.0.1

# --- Der Hub (optional) ------------------------------------------------------
#
# Kein Feature der App setzt ihn voraus (ADR-008). Er spart Requests: wer Conny
# Plank einmal ausgeklappt hat, erspart es allen anderen.

HUB_PORT=8787
HUB_BIND=127.0.0.1

# Leer heißt offen. Im Heimnetz in Ordnung, hinter einem Tunnel nicht.
HUB_SECRET=

# --- Von unterwegs (optional) ------------------------------------------------
#
# Ohne Token macht cloudflared einen Schnelltunnel mit zufälligem Hostnamen.
# Zum Ausprobieren gut, für Dauerbetrieb nicht: ein neuer Hostname ist ein
# neuer Origin und damit eine leere Datenbank auf dem Telefon.
#
# Mit Token läuft ein benannter Tunnel unter fester Adresse — dann bleiben die
# Daten auf dem Gerät zwischen zwei Sitzungen erhalten.
TUNNEL_TOKEN=
