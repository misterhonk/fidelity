# Copy to .env for local development. Never commit the real file.

# --- Database ---------------------------------------------------------------
# Read at runtime by server/db/client.ts and by drizzle-kit.
# Inside the Docker network the host is `db`, from the host it is `localhost`.
DATABASE_URL=postgres://fidelity:dev@localhost:5432/fidelity

# --- Discogs OAuth 1.0a (M1) ------------------------------------------------
# Register the app at https://www.discogs.com/settings/developers
# The Nitro runtime reads these via runtimeConfig (NUXT_ prefix).
NUXT_DISCOGS_CONSUMER_KEY=
NUXT_DISCOGS_CONSUMER_SECRET=

# 32+ random bytes. Encrypts OAuth tokens at rest via pgcrypto.
# Generate with: openssl rand -base64 48
NUXT_TOKEN_KEY=

# --- docker/compose.yml -----------------------------------------------------
# Compose reads its own .env next to the compose file (docker/.env).
# Both are optional; without them the app starts with OAuth disabled.
DISCOGS_KEY=
DISCOGS_SECRET=

# Cloudflare Tunnel for mobile/PWA/OAuth-callback tests:
#   docker compose -f docker/compose.yml --profile tunnel up
CF_TUNNEL_TOKEN=
