# Dependencies
node_modules/
.pnpm-store/

# Build output
.output/
.nuxt/
.nitro/
.cache/
# Symlink to .output/public that the static Nitro preset creates.
# Without the trailing slash this also matches the symlink itself.
dist

# Env & secrets
.env
.env.*
!.env.example

# Local data
data/dumps/
data/tmp/
*.sqlite
*.sqlite-*

# Generated design tokens (built from tokens/*.json by `pnpm tokens:build`)
app/assets/css/tokens.css

# Generated app icons (built from tokens/core.json by `pnpm icons:build`)
public/icons/
public/icon.svg

# Test artifacts
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# Logs
*.log
logs/

# OS / Editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
