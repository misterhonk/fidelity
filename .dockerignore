# Everything the build makes for itself, and everything it must not see.
node_modules
**/node_modules
.output
# Ausnahme für deploy/app.prebuilt.Dockerfile: das erwartet die fertige Seite
# von außen, statt sie selbst zu bauen. Der Rest von .output — der Server-Teil,
# den diese App gar nicht hat — bleibt draußen.
!.output/public
# Und die nginx-Konfiguration mit der Content-Security-Policy dieses Builds
# (scripts/csp/write.mjs) — die Zeile hat beim Release 0.91.2 gefehlt.
!.output/nginx.conf
.nuxt
dist
coverage
test-results
playwright-report
.git
.env
*.log

# The scratch space and the docs are not part of an image.
docs
*.html
!public/**/*.html
