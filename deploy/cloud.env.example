# deploy/compose.cloud.yml — copy to .env beside it and fill in.
DOMAIN=fidelity.example.org
# Which images: stable (promoted releases) or latest (every release).
CHANNEL=stable
# The hub's doors: a secret for a private box, a public key for members.
HUB_SECRET=
HUB_ACCESS_PUBLIC_KEY=
HUB_ACCESS_URL=
HUB_ACCESS_REVOKED=
HUB_WATCH=0
HUB_VAPID_SUBJECT=mailto:you@example.org
HUB_DISCOGS_KEY=
HUB_DISCOGS_SECRET=
