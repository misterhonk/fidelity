# --- 0. Wurzel oder Unterverzeichnis ------------------------------------------
#
# Jede Umschreibung hier steht **ohne führenden Schrägstrich**, und das ist der
# einzige Grund, warum diese Datei an beiden Orten funktioniert: mod_rewrite
# löst eine relative Ersetzung gegen das Verzeichnis auf, in dem die .htaccess
# liegt. Mit "/basket" landete jemand unter martinmelcher.de/fidelity/ auf
# martinmelcher.de/basket — also auf einer fremden Seite.
#
# Der zweite Teil derselben Sache steht in nuxt.config.ts: die App muss mit
# NUXT_APP_BASE_URL gebaut werden, sonst sucht sie ihre eigenen Dateien unter
# /_nuxt/ statt unter /fidelity/_nuxt/.

# Fidelity auf einem Apache-Webspace.
#
# Diese Datei gehört neben die entpackte Seite in den Docroot. Sie ist das
# Apache-Gegenstück zu deploy/nginx.conf und regelt dieselben zwei Dinge — die
# beiden, an denen ein statisch ausgeliefertes Frontend sonst lautlos bricht.
#
# Wenn dein Webspace .htaccess ignoriert (manche Anbieter schalten
# AllowOverride ab), funktioniert die App beim ersten Aufruf trotzdem und
# zeigt beim Neuladen einer Unterseite einen 404. Dann hilft nur der Anbieter.

# --- 1. Die alten, deutschen Adressen -----------------------------------------
#
# Bis ADR-010 lag jeder Bildschirm unter einem deutschen Pfad. Eine echte 301
# korrigiert das Lesezeichen in der Adresszeile; ohne Server macht die App
# dasselbe selbst.
#
# `QSA` ist Pflicht, keine Feinheit: der Tresor kommt aus dem OAuth-Fenster von
# Dropbox oder Google auf das zurück, was einmal /einstellungen/abgleich war —
# mit `?code=…` daran. Diese Adresse haben Nutzer beim Anbieter registriert und
# lässt sich von hier aus nicht ändern. Fällt die Abfrage weg, scheitert der
# ganze Austausch.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "^korb/?$" "basket" [R=301,L,QSA]
  RewriteRule "^regal/?$" "shelf" [R=301,L,QSA]
  RewriteRule "^haendler/?$" "dealers" [R=301,L,QSA]
  RewriteRule "^landkarte/?$" "map" [R=301,L,QSA]
  RewriteRule "^gemerkt/?$" "saved" [R=301,L,QSA]
  RewriteRule "^im-laden/?$" "in-store" [R=301,L,QSA]
  RewriteRule "^willkommen/?$" "welcome" [R=301,L,QSA]
  RewriteRule "^datenschutz/?$" "privacy" [R=301,L,QSA]
  RewriteRule "^impressum/?$" "legal" [R=301,L,QSA]
  RewriteRule "^einstellungen/abgleich/?$" "settings/sync" [R=301,L,QSA]
  RewriteRule "^einstellungen/darstellung/?$" "settings/appearance" [R=301,L,QSA]
  RewriteRule "^einstellungen/daten/?$" "settings/data" [R=301,L,QSA]
  RewriteRule "^einstellungen/hilfe/?$" "settings/help" [R=301,L,QSA]
  RewriteRule "^einstellungen/hub/?$" "settings/hub" [R=301,L,QSA]
  RewriteRule "^einstellungen/konto/?$" "settings/account" [R=301,L,QSA]
  RewriteRule "^einstellungen/sammlung/?$" "settings/collection" [R=301,L,QSA]
  RewriteRule "^einstellungen/suche/?$" "settings/search" [R=301,L,QSA]
  RewriteRule "^einstellungen/?$" "settings" [R=301,L,QSA]
</IfModule>

# --- 2. Jede Adresse fällt auf 200.html ---------------------------------------
#
# Die App erzeugt ihre Seiten im Browser: /basket existiert als Datei nicht.
# Ohne diesen Rückfall ist jedes Neuladen einer Unterseite und jedes Lesezeichen
# ein 404.
#
# Die beiden Bedingungen davor sind der ganze Trick: existiert die Datei oder
# das Verzeichnis wirklich, wird nichts umgeschrieben — sonst würde auch jedes
# Bild und jedes Skript als 200.html ausgeliefert.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . 200.html [L]
</IfModule>

# --- 3. Was wie lange liegen bleiben darf -------------------------------------
<IfModule mod_headers.c>
  # Der Service Worker entscheidet, wann alles andere aktualisiert wird. Ist er
  # selbst veraltet, lässt sich die App nie wieder reparieren — ein zwischen-
  # gespeichertes sw.js ist der einzige wirklich teure Fehler auf dieser Seite.
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>

  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Gehashte Dateinamen: ändert sich der Inhalt, ändert sich der Name. Der
  # Browser muss also nie wieder nachfragen.
  <FilesMatch "^.*\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Nichts hiervon gehört in einen Suchindex (docs/00 §9).
  Header set X-Robots-Tag "noindex, nofollow"

  # Die App spricht mit api.discogs.com und mit einem Hub, den der Nutzer
  # benennt. Sie bettet nichts ein und ist nicht dazu gedacht, eingebettet zu
  # werden.
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set Referrer-Policy "no-referrer"
</IfModule>

# --- 3. Komprimierung ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
