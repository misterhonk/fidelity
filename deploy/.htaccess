# --- 0. Wurzel oder Unterverzeichnis ------------------------------------------
#
# `RewriteBase` ist hier keine Kosmetik, sondern der Unterschied zwischen einer
# funktionierenden und einer absurden Weiterleitung.
#
# Ohne sie setzt Apache bei einer *externen* Regel (`[R=301]`) mit relativer
# Ersetzung den Dateisystempfad davor. Gemessen am 2026-08-11 unter
# martinmelcher.de/fidelity/ ergab "^korb/?$" → "basket" tatsächlich
#
#   301 → https://martinmelcher.de/var/www/virtual/mmelcher/html/fidelity/basket
#
# Also die Serverfestplatte in der Adresszeile. Mit absolutem "/basket" wäre es
# stattdessen die Domainwurzel gewesen — beides falsch, und zwar auf
# unterschiedliche Weise. Nur `RewriteBase` sagt mod_rewrite, worauf sich eine
# relative Ersetzung beziehen soll.
#
# Der Wert wird beim Ausliefern eingesetzt (.github/workflows/deploy.yml) und
# ist dieselbe Zahl, mit der die App gebaut wurde: NUXT_APP_BASE_URL. Steht
# hier noch der Platzhalter, ist die Datei von Hand kopiert worden — dann muss
# er ersetzt werden, sonst ist die Datei still unwirksam.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase __FIDELITY_BASE__
  RewriteRule "^korb/?$" "basket" [R=301,L,QSA]
  RewriteRule "^regal/?$" "shelf" [R=301,L,QSA]
  RewriteRule "^haendler/?$" "dealers" [R=301,L,QSA]
  RewriteRule "^landkarte/?$" "map" [R=301,L,QSA]
  RewriteRule "^gemerkt/?$" "saved" [R=301,L,QSA]
  RewriteRule "^im-laden/?$" "in-store" [R=301,L,QSA]
  RewriteRule "^willkommen/?$" "welcome" [R=301,L,QSA]
  RewriteRule "^datenschutz/?$" "privacy" [R=301,L,QSA]
  RewriteRule "^impressum/?$" "legal" [R=301,L,QSA]
  RewriteRule "^einstellungen/abgleich/?$" "settings/sync" [R=301,L,QSA]
  RewriteRule "^einstellungen/darstellung/?$" "settings/appearance" [R=301,L,QSA]
  RewriteRule "^einstellungen/daten/?$" "settings/data" [R=301,L,QSA]
  RewriteRule "^einstellungen/hilfe/?$" "settings/help" [R=301,L,QSA]
  RewriteRule "^einstellungen/hub/?$" "settings/hub" [R=301,L,QSA]
  RewriteRule "^einstellungen/konto/?$" "settings/account" [R=301,L,QSA]
  RewriteRule "^einstellungen/sammlung/?$" "settings/collection" [R=301,L,QSA]
  RewriteRule "^einstellungen/suche/?$" "settings/search" [R=301,L,QSA]
  RewriteRule "^einstellungen/?$" "settings" [R=301,L,QSA]
</IfModule>

# --- 2. Jede Adresse fällt auf 200.html ---------------------------------------
#
# Die App erzeugt ihre Seiten im Browser: /basket existiert als Datei nicht.
# Ohne diesen Rückfall ist jedes Neuladen einer Unterseite und jedes Lesezeichen
# ein 404.
#
# Die beiden Bedingungen davor sind der ganze Trick: existiert die Datei oder
# das Verzeichnis wirklich, wird nichts umgeschrieben — sonst würde auch jedes
# Bild und jedes Skript als 200.html ausgeliefert.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase __FIDELITY_BASE__
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . 200.html [L]
</IfModule>

# --- 3. Was wie lange liegen bleiben darf -------------------------------------
<IfModule mod_headers.c>
  # Der Service Worker entscheidet, wann alles andere aktualisiert wird. Ist er
  # selbst veraltet, lässt sich die App nie wieder reparieren — ein zwischen-
  # gespeichertes sw.js ist der einzige wirklich teure Fehler auf dieser Seite.
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>

  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Gehashte Dateinamen: ändert sich der Inhalt, ändert sich der Name. Der
  # Browser muss also nie wieder nachfragen.
  <FilesMatch "^.*\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Nichts hiervon gehört in einen Suchindex (docs/00 §9).
  Header set X-Robots-Tag "noindex, nofollow"

  # Die App spricht mit api.discogs.com und mit einem Hub, den der Nutzer
  # benennt. Sie bettet nichts ein und ist nicht dazu gedacht, eingebettet zu
  # werden.
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set Referrer-Policy "no-referrer"
</IfModule>

# --- 3. Komprimierung ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
