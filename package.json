{
  "name": "fidelity",
  "version": "0.3.0",
  "private": true,
  "description": "Fidelity – ein Kaufberater für Discogs",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm tokens:build && pnpm icons:build && nuxt dev",
    "build": "pnpm tokens:build && pnpm icons:build && nuxt build",
    "preview": "nuxt preview",
    "postinstall": "pnpm tokens:build && pnpm icons:build && nuxt prepare",
    "tokens:build": "node scripts/tokens/build.mjs",
    "icons:build": "node scripts/icons/build.mjs && node scripts/icons/lucide.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck && tsc --noEmit -p tsconfig.lib.json",
    "commitlint": "commitlint",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size": "size-limit"
  },
  "dependencies": {
    "@nuxt/ui": "^4.10.0",
    "@tanstack/vue-virtual": "^3.13.35",
    "idb": "^8.0.3",
    "nuxt": "^4.5.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@iconify-json/lucide": "^1.2.122",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.62.1",
    "@size-limit/file": "^13.0.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "size-limit": "^13.0.3",
    "style-dictionary": "^5.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
