{
  "name": "fidelity",
  "version": "0.0.0",
  "private": true,
  "description": "Fidelity – ein Kaufberater für Discogs",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm tokens:build && nuxt dev",
    "build": "pnpm tokens:build && nuxt build",
    "preview": "nuxt preview",
    "postinstall": "pnpm tokens:build && nuxt prepare",
    "tokens:build": "node scripts/tokens/build.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "commitlint": "commitlint",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nuxt/ui": "^4.10.0",
    "drizzle-orm": "0.45.2",
    "nuxt": "^4.5.2",
    "pg": "^8.23.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.62.1",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "style-dictionary": "^5.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
